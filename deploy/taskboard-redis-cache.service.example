[Unit]
Description=Frappe bench Redis cache for Taskboard
After=network.target

[Service]
Type=simple
User=frappe
Group=frappe
WorkingDirectory=/srv/frappe-bench
ExecStart=/usr/bin/redis-server /srv/frappe-bench/config/redis_cache.conf --daemonize no
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
